# ============================================
#  电台:radio_my —— 歌曲资产定义(music.asset)
# ============================================
# 规则:
#  - 本文件放哪、叫什么名都行,游戏扫描 music/ 下所有 .asset
#  - name 是"歌曲全局唯一 ID",不能和任何已加载 mod 的歌重名
#  - file 相对于本文件所在目录,指向 .ogg 音频(游戏只认 OGG Vorbis)
#  - volume 0~1 播放音量

music = {
	name = "示例歌曲一"
	file = "示例歌曲一.ogg"
	volume = 0.65
}

music = {
	name = "示例歌曲二"
	file = "示例歌曲二.ogg"
	volume = 0.65
}
